# OFI — Orbital Flame Intelligence
# Copy this file to .env and fill in real values. NEVER commit .env.

# Local SQLite database.
DATABASE_URL=file:../db/custom.db

# Optional — external LLM key for FLARE AI.
# When unset, FLARE AI uses the bundled server-side SDK and automatically
# degrades to deterministic retrieval-only mode if the LLM is unavailable.
# Keys are read server-side only and are never exposed to the browser.
GEMINI_API_KEY=
